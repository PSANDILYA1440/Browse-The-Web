{
  "name": "browse-the-web",
  "productName": "Browse The Web",
  "description": "A private Chromium browser for the web.",
  "author": "Prakhhar Sandilya (PSANDILYA1440)",
  "private": true,
  "version": "1.0.0",
  "main": "Chromium/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "start": "sh -c 'vite --host 127.0.0.1 & vite_pid=$!; trap \"kill $vite_pid\" EXIT; electron .'",
    "dist:mac": "vite build && electron-builder --mac --universal"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.paarth.browsetheweb",
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "mergeASARs": false,
      "icon": "src/images/Logo.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "files": [
      "dist/**/*",
      "Chromium/**/*",
      "GoEngine/engine",
      "CPPEngine/optimizer",
      "package.json"
    ],
    "asarUnpack": [
      "GoEngine/engine",
      "CPPEngine/optimizer"
    ]
  }
}
